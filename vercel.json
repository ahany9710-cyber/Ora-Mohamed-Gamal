{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/silversands", "destination": "/silversands.html" },
    { "source": "/thank-you", "destination": "/silversands.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "trailingSlash": false
}
