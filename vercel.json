    { "source": "/solana-east/", "destination": "/index.html" },
    { "source": "/zed-east", "destination": "/index.html" },
    { "source": "/zed-east/", "destination": "/index.html" },
    { "source": "/zed-west", "destination": "/index.html" },
    { "source": "/zed-west/", "destination": "/index.html" },
    { "source": "/solana-west", "destination": "/index.html" },
    { "source": "/solana-west/", "destination": "/index.html" },
    { "source": "/silversands", "destination": "/index.html" },
    { "source": "/silversands/", "destination": "/index.html" }
