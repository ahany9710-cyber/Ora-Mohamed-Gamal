{
  "name": "ora-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run quiz:sync && vite build",
    "quiz:sync": "rm -rf public/quiz/assets && cp -R wp-plugin/flair-ora-quiz/assets public/quiz/assets",
    "quiz:zip": "cd wp-plugin && rm -f flair-ora-quiz.zip && zip -rq flair-ora-quiz.zip flair-ora-quiz -x '*.DS_Store'",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
